rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isValidId(settingId);
    }

    match /ads/{placementKey} {
      allow read: if isValidId(placementKey);
      allow write: if isValidId(placementKey);
    }

    match /test/{testId} {
      allow read: if isValidId(testId);
      allow write: if isValidId(testId);
    }
  }
}
